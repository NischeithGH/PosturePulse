[Unit]
Description=Posture Pulse dashboard
After=network.target
Wants=network.target

[Service]
# Change `pi` and the paths below to match your Raspberry Pi setup.
User=pi
WorkingDirectory=/home/pi/posture-pulse/RPi
ExecStart=/home/pi/posture-pulse/.venv/bin/python -u /home/pi/posture-pulse/RPi/app.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
